{
  "name": "codemate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/migrate-production.mjs",
    "dev:socket": "tsx --env-file=.env socket-server/index.ts",
    "test:socket:faults": "tsx scripts/test-socket-faults.ts",
    "migrate:github-tokens": "tsx scripts/migrate-github-tokens.ts",
    "build:socket": "tsc -p socket-server/tsconfig.json",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:e2e:prepare": "tsx e2e/scripts/assert-safe-database.ts && prisma generate && prisma db push --force-reset && tsx e2e/scripts/seed.ts",
    "test:e2e": "npm run test:e2e:prepare && playwright test",
    "test:e2e:ui": "npm run test:e2e:prepare && playwright test --ui"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.73.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@octokit/rest": "^22.0.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tanstack/react-query": "^5.90.21",
    "@types/react-syntax-highlighter": "^15.5.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.563.0",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "next-swagger-doc": "^0.4.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.7.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.7",
    "swagger-ui-react": "^5.34.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jest": "^30.2.0",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "eslint-plugin-react-hooks": "7.0.1",
    "swagger-client": {
      "deepmerge": "4.1.1"
    },
    "@swagger-api/apidom-reference": {
      "minimatch": "11.0.5"
    }
  }
}
